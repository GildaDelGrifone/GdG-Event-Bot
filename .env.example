# Telegram Configuration
TELEGRAM_BOT_TOKEN=your_bot_token_here
TELEGRAM_BOT_USERNAME=your_bot_username_here
PUBLIC_CHANNEL_ID=-100xxxxxxxxxx
ADMIN_CHAT_ID=your_admin_user_or_group_id

# Google Gemini AI Configuration
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.1-flash-lite

# BoardGameGeek API Configuration (Optional)
# If omitted or empty, the bot automatically falls back to Wikipedia and web search
# to retrieve game images without BGG 401 Unauthorized errors.
# BGG_API_TOKEN=your_bgg_api_token_here

# WordPress REST API Configuration
WP_URL=https://www.gildadelgrifonetorino.it
WP_USERNAME=your_wp_username
WP_APP_PASSWORD=xxxx xxxx xxxx xxxx
WP_POST_CATEGORY=


# Instagram Graph API (Optional / Meta Developer)
IG_ACCESS_TOKEN=EAAG...
IG_ACCOUNT_ID=178414...

# Storage Configuration (Optional)
# DATA_DIR=/path/to/custom/data

# Feature Flags (Optional)
# ALLOW_GROUP_EVENT_NEXT=true

# Collage Configuration (Optional)
MAX_EVENTS_PER_ROW=4
